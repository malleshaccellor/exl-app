import type { Descendant } from "slate";
import {
  cellToHtml,
  cellToHtmlArray,
  nodeToHtml,
  htmlToCellChildren,
  htmlArrayToCellChildren,
} from "./htmlConversion";

/**
 * For a table-cell, return plain text if the cell is a single unformatted paragraph,
 * or full HTML if it has block-level styles (align/indent/fontSize) or multiple paragraphs.
 * This keeps the JSON clean for simple cells while preserving all formatting on round-trip.
 */
const cellToTextOrHtml = (cell: { children?: Descendant[] }): string => {
  const children = (cell.children || []) as any[];
  if (children.length === 1 && children[0].type === "paragraph") {
    const para = children[0];
    if (!para.align && !para.indent && !para.fontSize) {
      // Plain paragraph — return inline-marks-aware text, no <p> wrapper
      return (para.children || [])
        .map((leaf: any) => {
          if (!leaf.text) return "";
          if (leaf.bold || leaf.italic || leaf.underline || leaf.strikethrough || leaf.code) {
            return nodeToHtml(leaf);
          }
          return leaf.text as string;
        })
        .join("");
    }
  }
  // Multiple paragraphs or has block formatting — emit full HTML
  return cellToHtml(cell);
};

/**
 * Same logic for array fields (AcceptanceCriteria):
 * each paragraph item becomes plain text or HTML depending on formatting.
 */
const cellToTextOrHtmlArray = (cell: { children?: Descendant[] }): string[] => {
  const children = (cell.children || []) as any[];
  return children
    .map((child: any) => {
      if (child.type === "paragraph" && !child.align && !child.indent && !child.fontSize) {
        return (child.children || [])
          .map((leaf: any) => {
            if (!leaf.text) return "";
            if (leaf.bold || leaf.italic || leaf.underline || leaf.strikethrough || leaf.code) {
              return nodeToHtml(leaf);
            }
            return leaf.text as string;
          })
          .join("");
      }
      // Formatted paragraph — emit full HTML
      return nodeToHtml(child);
    })
    .filter((t: string) => t.trim().length > 0);
};

export const VISIBLE_COLUMNS = [
  { key: "req_id", label: "Req No." },
  { key: "userstory_id", label: "User Story No." },
  { key: "Story", label: "User Story Description" },
  { key: "AcceptanceCriteria", label: "Acceptance Criteria" },
  { key: "RequirementType", label: "Requirement Type" },
];

export const HIDDEN_STORY_KEYS = [
  "source",
  "referred_document",
  "referred_doc_location",
  "section",
  "justification",
  "referred_in",
  "source_timestamp",
];

export const jsonToSlateValue = (data: Record<string, any>): Descendant[] => {
  const allRows: any[] = [];

  for (const [reqName, reqData] of Object.entries(data)) {
    for (const story of reqData.UserStories || []) {
      const hiddenData: Record<string, string> = {
        Requirement: reqName,
        RequirementDescription: reqData.RequirementDescription,
      };
      for (const key of HIDDEN_STORY_KEYS) {
        hiddenData[key] = story[key] != null ? String(story[key]) : "";
      }

      allRows.push({
        type: "table-row",
        hiddenData,
        children: VISIBLE_COLUMNS.map(({ key }) => {
          let val: any;
          if (key === "req_id") val = reqData.req_id;
          else val = story[key];

          if (Array.isArray(val)) {
            return {
              type: "table-cell",
              // Each HTML string in the array → proper Slate nodes with styles restored
              children: htmlArrayToCellChildren(val),
            };
          }
          return {
            type: "table-cell",
            // HTML string → Slate nodes with align/indent/fontSize restored
            children: htmlToCellChildren(val != null ? String(val) : ""),
          };
        }),
      });
    }
  }

  const headerRow = {
    type: "table-row" as const,
    children: VISIBLE_COLUMNS.map(({ label }) => ({
      type: "table-cell" as const,
      isHeader: true,
      children: [
        { type: "paragraph" as const, children: [{ text: label }] },
      ],
    })),
  };

  return [
    {
      type: "table",
      className: "editor-custom-table",
      children: [headerRow, ...allRows],
    },
  ];
};

export const slateValueToJson = (nodes: Descendant[]): Record<string, any> => {
  const tableNode = (nodes as any[]).find((n: any) => n.type === "table");
  if (!tableNode) return {};

  const rows = tableNode.children;
  const dataRows = rows.slice(1);

  const result: Record<string, any> = {};

  for (const row of dataRows) {
    const cells = row.children;
    const hidden = row.hiddenData || {};

    // Use smart helper: plain text for unformatted cells, HTML when formatting is present
    const reqId = cellToTextOrHtml(cells[0]);
    const reqName = hidden.Requirement || "";
    const reqDesc = hidden.RequirementDescription || "";

    if (!result[reqName]) {
      result[reqName] = {
        req_id: reqId,
        RequirementDescription: reqDesc,
        UserStories: [],
      };
    }

    const story: Record<string, any> = {
      userstory_id: cellToTextOrHtml(cells[1]),
      Story: cellToTextOrHtml(cells[2]),
      // AcceptanceCriteria is always an array — each paragraph item → text or HTML
      AcceptanceCriteria: cellToTextOrHtmlArray(cells[3]),
      RequirementType: cellToTextOrHtml(cells[4]),
    };

    for (const key of HIDDEN_STORY_KEYS) {
      story[key] = hidden[key] || "";
    }

    result[reqName].UserStories.push(story);
  }

  return result;
};
