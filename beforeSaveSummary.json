type StakeHolder = {
  Name?: string;
  Organization?: string;
  Role?: string;
  Responsibility?: string;
};

type ActorPersona = {
  Type_of_User?: string;
  Role?: string[] | string;
  Access_Type?: string[] | string;
};

type Citation = {
  source?: string;
  referred_document?: string;
  referred_doc_location?: string;
  section?: string;
  justification?: string;
  referred_in?: string;
  source_timestamp?: string;
  score?: any;
};

const isMeaningfulCitation = (c: any) => {
  if (!c || typeof c !== "object") return false;

  return Boolean(
    c.source ||
    c.referred_document ||
    c.referred_doc_location ||
    c.section ||
    c.justification ||
    c.referred_in ||
    c.source_timestamp ||
    c.score,
  );
};

const CitationsBlock = ({
  citations,
  debugKey,
}: {
  citations?: Citation[];
  debugKey?: string;
}) => {
  // ✅ Filter out placeholders like {}, null, "", etc.
  const items = Array.isArray(citations)
    ? citations.filter(isMeaningfulCitation)
    : [];

  const [open, setOpen] = React.useState(false);

  // ✅ Optional debug: helps prove backend is sending empty objects
  useEffect(() => {
    if (!debugKey) return;
    if (!Array.isArray(citations)) return;

    const rawLen = citations.length;
    const meaningfulLen = items.length;

    if (rawLen !== meaningfulLen) {
      // eslint-disable-next-line no-console
      // console.log(
      //   `[BRD][Citations][${debugKey}] raw=${rawLen}, meaningful=${meaningfulLen}`,
      //   { raw: citations, meaningful: items },
      // );
    }
  }, [citations, items, debugKey]);

  if (!items.length) return null;

  return (
    <Box
      sx={{
        mt: 1.5,
        p: 1.5,
        borderRadius: 1,
        border: "1px solid rgba(0,0,0,0.08)",
      }}
    >
      <Box
        sx={{
          display: "flex",
          alignItems: "center",
          justifyContent: "space-between",
        }}
      >
        <Typography sx={{ fontWeight: 700 }}>
          Citations ({items.length})
        </Typography>

        <Button size="small" onClick={() => setOpen((v) => !v)}>
          {open ? "Hide" : "Show"}
        </Button>
      </Box>

      <Collapse in={open} timeout="auto" unmountOnExit>
        <Box sx={{ mt: 1 }}>
          <ol style={{ margin: 0, paddingLeft: "1.2rem", fontSize: "0.85rem" }}>
            {items.map((c, idx) => (
              <li key={idx} style={{ marginBottom: 10 }}>
                <div>
                  {c?.source ? ` — ${c.source} ` : ""}
                  <b>{c?.referred_document ?? "Source document"}</b>
                  {c?.source_timestamp ? ` (${c.source_timestamp})` : ""}
                  {c?.score ? ` (score: ${c.score})` : ""}
                </div>

                {c?.section ? (
                  <div style={{ opacity: 0.85 }}>Section: {c.section}</div>
                ) : null}
                {c?.justification ? (
                  <div style={{ opacity: 0.85 }}>{c.justification}</div>
                ) : null}
                {c?.referred_in ? (
                  <div style={{ opacity: 0.85 }}>{c.referred_in}</div>
                ) : null}

                {/* {c?.referred_doc_location ? (
                  <a
                    href={c.referred_doc_location}
                    target="_blank"
                    rel="noreferrer"
                    style={{ display: "inline-block", marginTop: 4 }}
                  >
                    Open referred document
                  </a>
                ) : null} */}
              </li>
            ))}
          </ol>
        </Box>
      </Collapse>
    </Box>
  );
};

const Section = ({ title, children, citations, citationsDebugKey }) => (
  <Box sx={{ mb: 3 }} className={styles.sectionRow}>
    <h5>
      {/* Changed div to span to avoid hydration mismatch */}
      <span dangerouslySetInnerHTML={{ __html: title }} />
    </h5>
    {children}
    <CitationsBlock citations={citations} debugKey={citationsDebugKey} />
  </Box>
);

const Bullets = ({ items }: { items: any }) => {
  const arr = asArray(items);
  if (!arr.length) return null;

  return (
    <Box component="ul" sx={{ pl: 3, mt: 1, mb: 2 }}>
      {arr.map((t, i) => (
        <li key={i}>
          {/* ✅ If caller passes JSX (like renderText -> <mark/>), render it directly */}
          {React.isValidElement(t) ? (
            t
          ) : (
            // <p>{String(t ?? "")}</p>
            <p>
              {
                <span
                  dangerouslySetInnerHTML={{
                    __html: String(t ?? ""),
                  }}
                />
              }
            </p>
          )}
        </li>
      ))}
    </Box>
  );
};
const HtmlBullets = ({ items }: { items: any }) => {
  const arr = asArray(items);
  if (!arr.length) return null;

  return (
    <Box component="ul" sx={{ pl: 3, mt: 1, mb: 2 }}>
      {arr.map((t, i) => (
        <li key={i}>
          <span dangerouslySetInnerHTML={{ __html: String(t ?? "") }} />
        </li>
      ))}
    </Box>
  );
};
const SimpleTable = ({
  columns,
  rows,
}: {
  columns: { key: string; label: string; width?: string }[];
  rows: any[];
}) => {
  if (!Array.isArray(rows) || rows.length === 0) return null;

  return (
    <div className={styles.tableContainer}>
      <Table>
        <TableHead>
          <TableRow>
            {columns.map((c) => (
              <TableCell key={c.key} sx={{ width: c.width }}>
                {c.label}
              </TableCell>
            ))}
          </TableRow>
        </TableHead>

        <TableBody>
          {rows.map((r, idx) => (
            <TableRow key={idx}>
              {columns.map((c) => {
                const val = r?.[c.key];

                // ✅ When showComments=true, you pass React nodes here (div/mark/array)
                if (React.isValidElement(val) || Array.isArray(val)) {
                  return <TableCell key={c.key}>{val}</TableCell>;
                }

                // ✅ Otherwise treat as HTML string (keeps your existing behavior)
                return (
                  <TableCell
                    key={c.key}
                    dangerouslySetInnerHTML={{
                      __html: String(val ?? "-"),
                    }}
                  />
                );
              })}
            </TableRow>
          ))}
        </TableBody>
      </Table>
    </div>
  );
};
