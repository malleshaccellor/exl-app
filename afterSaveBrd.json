// utils/findCommentRanges.ts
import { Editor, Text, Path, Point, Range } from "slate";

export interface CommentRange {
  commentId: string;
  anchor: { path: number[]; offset: number };
  focus: { path: number[]; offset: number };
}

export function findCommentRanges(
  editor: Editor,
  comments: { id: string; text: string }[]
): CommentRange[] {
  const result: CommentRange[] = [];

  for (const comment of comments) {
    if (!comment.text) continue;

    // Walk all text nodes
    for (const [node, path] of Editor.nodes(editor, {
      at: [],
      match: (n) => Text.isText(n),
    })) {
      if (!Text.isText(node)) continue;

      const nodeText = node.text;
      let start = 0;

      while (true) {
        const index = nodeText.indexOf(comment.text, start);
        if (index === -1) break;

        result.push({
          commentId: comment.id,
          anchor: { path, offset: index },
          focus: { path, offset: index + comment.text.length },
        });

        start = index + comment.text.length;
      }
    }
  }

  return result;
}


import {
  useCallback, useEffect, useMemo, useRef, useState
} from "react";
import {
  createEditor, Editor, Text, Point,
  type Descendant, type NodeEntry, type Range
} from "slate";
import { Slate, Editable, withReact } from "slate-react";
import { withHistory } from "slate-history";
import clsx from "clsx";
import Toolbar from "./Toolbar";
import { withTables } from "./plugins/withTables";
import { jsonToSlateValue } from "./utils/jsonConversion";
import { findCommentRanges, type CommentRange } from "./utils/findCommentRanges";
import type { textStyle } from "./types";
import styles from "./slate-editor.module.css";

interface Comment {
  id: string;
  text: string;
  isResolved: boolean;
  colField?: string;
}

interface SlateEditorProps {
  // ... your existing props
  comments?: Comment[];
}

export const SlateContentEditor = ({
  value,
  defaultValue = [],
  onChange,
  readOnly,
  onClickSaveBtn,
  className,
  data,
  onDiscard,
  hideFontActions,
  hideIndentActions,
  hideAlignmentActions,
  comments = [],
}: SlateEditorProps) => {
  const editor = useMemo(
    () => withTables(withHistory(withReact(createEditor()))),
    [],
  );

  const onSaveRef = useRef(onClickSaveBtn);
  onSaveRef.current = onClickSaveBtn;
  const onDiscardRef = useRef(onDiscard);
  onDiscardRef.current = onDiscard;

  const computedDefault = useMemo(() => {
    if (data) return jsonToSlateValue(data);
    return defaultValue;
  }, [data, defaultValue]);

  const [internalValue, setInternalValue] = useState<Descendant[]>(computedDefault);
  const editorValue = useMemo(() => value ?? internalValue, [value, internalValue]);

  // 👇 Store locked comment ranges in local state
  const [commentRanges, setCommentRanges] = useState<CommentRange[]>([]);
  const isInitialized = useRef(false);

  // 👇 On load, do text-match ONCE and lock the ranges
  useEffect(() => {
    if (isInitialized.current || comments.length === 0) return;

    // Editor needs children to be populated first
    // Use a small timeout to ensure Slate has initialized
    const timer = setTimeout(() => {
      const ranges = findCommentRanges(editor, comments);
      setCommentRanges(ranges);
      isInitialized.current = true;
    }, 0);

    return () => clearTimeout(timer);
  }, [editor, comments]);

  const handleChange = useCallback(
    (val: Descendant[]) => {
      if (!value) setInternalValue(val);
      onChange?.(val);

      // 👇 After each operation, transform locked ranges to stay in sync
      if (commentRanges.length === 0) return;

      setCommentRanges((prev) => {
        let updated = prev;

        for (const op of editor.operations) {
          updated = updated
            .map((cr) => {
              try {
                const newAnchor = Point.transform(
                  { path: cr.anchor.path, offset: cr.anchor.offset },
                  op
                );
                const newFocus = Point.transform(
                  { path: cr.focus.path, offset: cr.focus.offset },
                  op
                );

                // null means the point was deleted — drop this range
                if (!newAnchor || !newFocus) return null;

                return { ...cr, anchor: newAnchor, focus: newFocus };
              } catch {
                return null; // invalid range, drop it
              }
            })
            .filter((cr): cr is CommentRange => cr !== null);
        }

        return updated;
      });
    },
    [value, onChange, editor, commentRanges.length],
  );

  // 👇 Decorate using locked ranges (not text-match)
  const decorate = useCallback(
    ([node, path]: NodeEntry): Range[] => {
      if (!Text.isText(node) || commentRanges.length === 0) return [];

      const ranges: Range[] = [];

      for (const cr of commentRanges) {
        const isAnchorPath = JSON.stringify(cr.anchor.path) === JSON.stringify(path);
        const isFocusPath = JSON.stringify(cr.focus.path) === JSON.stringify(path);

        // Check if path is between anchor and focus for multi-node ranges
        const isBetween =
          cr.anchor.path.length === path.length &&
          path.every((v, i) => {
            if (i < path.length - 1) return v === cr.anchor.path[i];
            return v > cr.anchor.path[i] && v < cr.focus.path[i];
          });

        if (!isAnchorPath && !isFocusPath && !isBetween) continue;

        const startOffset = isAnchorPath ? cr.anchor.offset : 0;
        const endOffset = isFocusPath ? cr.focus.offset : node.text.length;

        if (startOffset === endOffset) continue;

        ranges.push({
          anchor: { path, offset: startOffset },
          focus: { path, offset: endOffset },
          highlight: true,
          commentId: cr.commentId,
        } as any);
      }

      return ranges;
    },
    [commentRanges],
  );

  const renderLeaf = useCallback(({ attributes, children, leaf }: any) => {
    if (leaf.bold) children = <strong>{children}</strong>;
    if (leaf.italic) children = <em>{children}</em>;
    if (leaf.underline) children = <u>{children}</u>;
    if (leaf.strikethrough) children = <s>{children}</s>;
    if (leaf.code) children = <code>{children}</code>;

    // 👇 Yellow highlight for comment ranges
    if (leaf.highlight) {
      children = (
        <mark style={{ backgroundColor: "#FFF176", borderRadius: "2px", padding: "1px 0" }}>
          {children}
        </mark>
      );
    }

    return <span {...attributes}>{children}</span>;
  }, []);

  // ... rest of your existing code (renderElement, handleKeyDown) unchanged

  return (
    <div className={styles.editorContainer}>
      <div className={styles.editorArea}>
        <Slate editor={editor} initialValue={editorValue} onChange={handleChange}>
          <Toolbar
            onClickSaveBtn={onClickSaveBtn ? handleSave : undefined}
            buttonLabel="Save"
            onDiscard={onDiscard ? handleDiscard : undefined}
            hideFontActions={hideFontActions}
            hideIndentActions={hideIndentActions}
            hideAlignmentActions={hideAlignmentActions}
          />
          <Editable
            renderLeaf={renderLeaf}
            renderElement={renderElement}
            readOnly={readOnly}
            onKeyDown={handleKeyDown}
            decorate={decorate}   // 👈 wired in
            className={clsx(styles.editableArea, className)}
          />
        </Slate>
      </div>
    </div>
  );
};
